# Public App ID from the Privy dashboard:
# Configuration → App settings → Basics → App ID
# The browser login modal needs this. It is safe to expose.
VITE_PRIVY_APP_ID=
PRIVY_APP_ID=

# Server only. Used by /api/privy/session to verify a login.
# Never commit the real value and never put it in client code.
PRIVY_APP_SECRET=
