# Public App ID from the Privy dashboard:
# Configuration → App settings → Basics → App ID
# The browser login modal needs this. It is safe to expose.
VITE_PRIVY_APP_ID=
PRIVY_APP_ID=

# Server only. Used to verify Privy logins and sign temporary agent claim codes.
# Never commit the real value and never put it in client code.
PRIVY_APP_SECRET=

# Server-only top-up claim store. Apply supabase/migrations/202606180001_verified_topups.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Base RPC override; defaults to https://mainnet.base.org.
BASE_RPC_URL=
