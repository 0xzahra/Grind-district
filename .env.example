# Proximity chat (Supabase Realtime, broadcast + presence; no tables needed).
# Copy to .env.local (gitignored via *.local) and fill in. The anon key is public-safe.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Certificate NFT mint. The NEAR testnet contract is live; Base stays unset until a Base deploy is approved.
# VITE_CERT_NFT_BASE=
# VITE_CERT_NFT_BASE_CHAIN=8453
VITE_CERT_NFT_NEAR=grinddistrict-cert.testnet
# Server signer keys (Vercel env, never commit). Required only when minting is live.
# CERT_SIGNER_PRIVATE_KEY=
# CERT_NEAR_SIGNER_KEY=
# CERT_BASE_RPC=
# CERT_NEAR_RPC=
# NEAR mainnet certificates ALONGSIDE testnet (deployed: cert.grinddistrict.near). Unset = off. See docs/multichain-router.md.
# VITE_CERT_NFT_NEAR_MAINNET=cert.grinddistrict.near
# CERT_NEAR_MAINNET_RPC=
# Optional EAS attestation on Base next to the NFT (both needed; uid of CERT_EAS_SCHEMA in api/_certEas.ts).
# CERT_EAS=1
# CERT_EAS_SCHEMA_UID=
# Solana certificates: Grind District's own Rust program (programs/grind-cert), deployed on devnet. Unset = off.
# VITE_CERT_SOLANA_PROGRAM=
# CERT_SOLANA_SIGNER_KEY=   (issuer keypair, 64-byte JSON array; server only)
# CERT_SOLANA_CLUSTER=devnet
# CERT_SOLANA_RPC=

# Email alerts for new messages (server only, set in Vercel > Settings > Environment Variables).
# A Gmail address and a Google "app password" for it (Google Account > Security > App passwords; needs 2-step
# verification). Without both, message emails are skipped; phone push alerts work without any setting.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# NEAR top-up (in-game balance paid in NEAR). Off until both are set, to the same account. A .testnet account
# means NEAR testnet top-ups (free test NEAR, for testing); a .near account means mainnet.
NEAR_TOPUP_ACCOUNT=grinddistrict-passport.testnet
VITE_NEAR_TOPUP_ACCOUNT=grinddistrict-passport.testnet
