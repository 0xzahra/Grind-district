# Proximity chat (Supabase Realtime, broadcast + presence; no tables needed).
# Copy to .env.local (gitignored via *.local) and fill in. The anon key is public-safe.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Certificate NFT mint. The NEAR testnet contract is live; Base stays unset until a Base deploy is approved.
# VITE_CERT_NFT_BASE=
# VITE_CERT_NFT_BASE_CHAIN=8453
VITE_CERT_NFT_NEAR=grinddistrict-cert.testnet
# Server signer keys (Vercel env, never commit). Required only when minting is live.
# CERT_SIGNER_PRIVATE_KEY=
# CERT_NEAR_SIGNER_KEY=
# CERT_BASE_RPC=
# CERT_NEAR_RPC=
