{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "grinddistrict.app"
        }
      ],
      "destination": "https://www.grinddistrict.app/",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "grinddistrict.app"
        }
      ],
      "destination": "https://www.grinddistrict.app/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/guide", "destination": "/how-it-works.html" },
    { "source": "/start", "destination": "/how-it-works.html" },
    { "source": "/certificates", "destination": "/certificates.html" },
    { "source": "/vs-courses", "destination": "/vs-courses.html" },
    { "source": "/compare", "destination": "/vs-courses.html" },
    {
      "source": "/api/stocks",
      "destination": "/api/track?op=stocks"
    },
    {
      "source": "/api/reward-wallet",
      "destination": "/api/profile?op=reward-wallet"
    },
    {
      "source": "/api/cert-voucher",
      "destination": "/api/profile?op=cert-voucher"
    },
    {
      "source": "/cv/:username",
      "destination": "/api/page?kind=cv&username=:username"
    },
    {
      "source": "/cert/:id/image.png",
      "destination": "/api/page?kind=certpng&id=:id"
    },
    {
      "source": "/cert/:id/meta.json",
      "destination": "/api/page?kind=certmeta&id=:id"
    },
    {
      "source": "/cert/:id",
      "destination": "/api/page?kind=cert&id=:id"
    },
    {
      "source": "/s/stats",
      "destination": "/api/page?kind=stats"
    },
    {
      "source": "/p/:id",
      "destination": "/api/page?kind=poster&id=:id"
    },
    {
      "source": "/api/agent-register",
      "destination": "/api/agent?op=register"
    },
    {
      "source": "/api/agent-me",
      "destination": "/api/agent?op=me"
    },
    {
      "source": "/api/agent-join",
      "destination": "/api/agent?op=join"
    },
    {
      "source": "/api/agent-move",
      "destination": "/api/agent?op=move"
    },
    {
      "source": "/api/agent-chat",
      "destination": "/api/agent?op=chat"
    },
    {
      "source": "/api/agent-earn",
      "destination": "/api/agent?op=earn"
    },
    {
      "source": "/api/agent-attend",
      "destination": "/api/agent?op=attend"
    },
    {
      "source": "/api/agent-events",
      "destination": "/api/agent?op=events"
    },
    {
      "source": "/api/agent-list",
      "destination": "/api/agent?op=list"
    },
    {
      "source": "/api/agent-identify",
      "destination": "/api/agent?op=identify"
    },
    {
      "source": "/agents",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/deposits-poll",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/messages?op=nudge",
      "schedule": "40 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/tex/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/page.ts": {
      "includeFiles": "{api/_fonts/**,public/brand/lockup.png,public/brand/shrimp.png}",
      "excludeFiles": "node_modules/@napi-rs/canvas-linux-x64-musl/**"
    },
    "api/track.ts": {
      "maxDuration": 30
    },
    "api/messages.ts": {
      "maxDuration": 60
    }
  }
}
