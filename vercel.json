{
  "rewrites": [
    {
      "source": "/cv/:username",
      "destination": "/api/page?kind=cv&username=:username"
    },
    {
      "source": "/cert/:id",
      "destination": "/api/page?kind=cert&id=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/deposits-poll",
      "schedule": "0 6 * * *"
    }
  ]
}